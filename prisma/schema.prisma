generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  plan UserPlan?

  soulScans     SoulScan[]
  dreamAnalyses DreamAnalysis[]
  tarotReadings TarotReading[]
  usage         UserUsage[]
}

model UserPlan {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan      String   @default("free")
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SoulScan {
  id String @id @default(cuid())

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  input     String
  archetype String
  emotion   String
  insight   String

  createdAt DateTime @default(now())

  @@index([userId])
}

model DreamAnalysis {
  id String @id @default(cuid())

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  dream          String
  summary        String
  emotion        String
  interpretation String

  createdAt DateTime @default(now())

  @@index([userId])
}

model TarotReading {
  id String @id @default(cuid())

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  card     String
  meaning  String
  guidance String

  createdAt DateTime @default(now())

  @@index([userId])
}

model UserUsage {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  soulScan Int @default(0)
  dream    Int @default(0)
  tarot    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
}

model GuestSession {
  id String @id @default(cuid())

  guestId String @unique

  soulScan Int @default(0)
  dream    Int @default(0)
  tarot    Int @default(0)

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([guestId])
}
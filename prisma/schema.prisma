generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique

  plan      UserPlan?
  usage     UserUsage?

  createdAt DateTime @default(now())

  soulScans     SoulScan[]
  dreamAnalyses DreamAnalysis[]
  tarotReadings TarotReading[]
}

model UserPlan {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  plan String @default("free")

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserUsage {
  id String @id @default(cuid())

  /*
   * One usage record per user.
   *
   * There is NO date field because
   * free usage is lifetime-based.
   */

  userId String @unique

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  /*
   * Lifetime usage counters.
   *
   * Each tool has its own free limit.
   */

  soulScan Int @default(0)
  dream    Int @default(0)
  tarot    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuestSession {
  id String @id @default(cuid())

  /*
   * Persistent anonymous browser identity.
   */

  guestId String @unique

  /*
   * Lifetime anonymous usage.
   */

  soulScan Int @default(0)
  dream    Int @default(0)
  tarot    Int @default(0)

  createdAt DateTime @default(now())

  /*
   * Guest sessions can eventually expire.
   * The cookie itself currently lives for one year.
   */

  expiresAt DateTime

  @@index([guestId])
}

model SoulScan {
  id String @id @default(cuid())

  /*
   * Nullable because guests are allowed
   * to use Soul Scan without registration.
   */

  userId String?

  input     String
  archetype String
  emotion   String
  insight   String

  createdAt DateTime @default(now())

  user User? @relation(
    fields: [userId],
    references: [id],
    onDelete: SetNull
  )

  @@index([userId])
}

model DreamAnalysis {
  id String @id @default(cuid())

  /*
   * Nullable because guests are allowed
   * to use Dream Analysis without registration.
   */

  userId String?

  dream          String
  summary        String
  emotion        String
  interpretation String

  createdAt DateTime @default(now())

  user User? @relation(
    fields: [userId],
    references: [id],
    onDelete: SetNull
  )

  @@index([userId])
}

model TarotReading {
  id String @id @default(cuid())

  /*
   * Nullable because guests are allowed
   * to use Tarot without registration.
   */

  userId String?

  card     String
  meaning  String
  guidance String

  createdAt DateTime @default(now())

  user User? @relation(
    fields: [userId],
    references: [id],
    onDelete: SetNull
  )

  @@index([userId])
}